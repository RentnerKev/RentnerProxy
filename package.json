{
    "name": "rentnerproxy",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "bun --no-orphans scripts/dev.ts",
        "dev:web": "bun --bun vite --config web/vite.config.ts",
        "dev:controller": "cargo run --manifest-path controller/Cargo.toml",
        "build": "bun --no-orphans scripts/build.ts",
        "build:web": "bun --bun vite build --config web/vite.config.ts && tsc --noEmit -p web/tsconfig.json",
        "build:controller": "cargo build --manifest-path controller/Cargo.toml",
        "typecheck": "tsc --noEmit -p web/tsconfig.json && tsc --noEmit -p scripts/tsconfig.json",
        "lint": "oxlint .",
        "format": "oxfmt . && cargo fmt --manifest-path controller/Cargo.toml",
        "format:check": "oxfmt --check . && cargo fmt --manifest-path controller/Cargo.toml -- --check",
        "test": "bun run test:ts && bun run rust:test",
        "test:ts": "bun test web/src",
        "db:generate": "drizzle-kit generate --config=web/drizzle.config.ts",
        "db:migrate": "bun web/src/db/migrate.server.ts",
        "db:check": "drizzle-kit check --config=web/drizzle.config.ts",
        "check": "bun --no-orphans scripts/check.ts",
        "rust:check": "cargo check --manifest-path controller/Cargo.toml --all-targets",
        "rust:test": "cargo test --manifest-path controller/Cargo.toml",
        "rust:lint": "cargo clippy --manifest-path controller/Cargo.toml --all-targets --all-features -- -D warnings",
        "rust:format": "cargo fmt --manifest-path controller/Cargo.toml",
        "rust:format:check": "cargo fmt --manifest-path controller/Cargo.toml -- --check"
    },
    "dependencies": {
        "@tanstack/react-router": "1.170.32",
        "@tanstack/react-start": "1.168.49",
        "drizzle-orm": "0.45.2",
        "react": "19.2.8",
        "react-dom": "19.2.8"
    },
    "devDependencies": {
        "@tailwindcss/vite": "4.3.3",
        "@types/bun": "1.4.0",
        "@types/node": "26.4.0",
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.5",
        "@vitejs/plugin-react": "6.1.0",
        "drizzle-kit": "0.31.10",
        "oxfmt": "0.65.0",
        "oxlint": "1.80.0",
        "tailwindcss": "4.3.3",
        "typescript": "7.0.2",
        "vite": "8.2.2"
    },
    "packageManager": "bun@1.4.0"
}
