{
    "name": "rentnerproxy",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "bun --no-orphans scripts/dev.ts",
        "dev:web": "bun --bun vite --configLoader native --config vite.config.ts",
        "dev:core": "cargo run --manifest-path core/Cargo.toml",
        "proxy:test-upstream": "bun scripts/smoke/proxy/upstream.ts",
        "proxy:smoke": "bun --no-orphans .github/scripts/ci/proxy-smoke.ts",
        "certificates:smoke": "bun --no-orphans scripts/smoke/certificates/run.ts",
        "upstream-tls:smoke": "bun --no-orphans scripts/smoke/proxy/upstream-tls.ts",
        "backup:production": "bun scripts/production-backup.ts",
        "restore:production": "bun scripts/production-restore.ts",
        "runtime:reliability": "bun --no-env-file --no-orphans scripts/runtime-reliability/run.ts",
        "runtime:scale": "bun --no-env-file --no-orphans scripts/runtime-scale/run.ts",
        "production:smoke": "bun --no-orphans .github/scripts/ci/appliance-compose-smoke.ts",
        "build": "bun --no-orphans scripts/build.ts",
        "build:web": "bun --bun vite build --configLoader native --config vite.config.ts && bun build web/src/server/WebSockets/realtimeWebSocket.ts --target=bun --outfile=web/dist/server/realtimeWebSocket.js && tsc --noEmit -p tsconfig.json",
        "build:core": "cargo build --release --manifest-path core/Cargo.toml",
        "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.scripts.json",
        "lint": "oxlint . && bun run lint:types",
        "lint:types": "oxlint --config .oxlintrc.type-aware.json .",
        "format": "oxfmt . && cargo fmt --manifest-path core/Cargo.toml",
        "format:check": "oxfmt --check . && cargo fmt --manifest-path core/Cargo.toml -- --check",
        "test": "bun run test:ts && bun run rust:test",
        "test:ts": "bun --no-env-file scripts/test-web.ts",
        "test:db": "bun --no-env-file scripts/test-web.ts --database",
        "test:fuzz": "bun --no-env-file scripts/test-web.ts --fuzz",
        "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
        "db:migrate": "bun web/src/db/migrate.ts",
        "db:check": "drizzle-kit check --config=drizzle.config.ts",
        "check": "bun --no-orphans scripts/check.ts",
        "rust:check": "cargo check --manifest-path core/Cargo.toml --all-targets",
        "rust:test": "cargo test --manifest-path core/Cargo.toml",
        "rust:lint": "cargo clippy --manifest-path core/Cargo.toml --all-targets --all-features -- -D warnings",
        "rust:format": "cargo fmt --manifest-path core/Cargo.toml",
        "rust:format:check": "cargo fmt --manifest-path core/Cargo.toml -- --check"
    },
    "dependencies": {
        "@codemirror/lang-html": "6.4.12",
        "@codemirror/language": "6.13.1",
        "@codemirror/state": "6.7.6",
        "@fontsource/lilita-one": "5.3.0",
        "@lezer/highlight": "1.2.5",
        "@radix-ui/react-dialog": "1.2.0",
        "@radix-ui/react-dropdown-menu": "2.1.25",
        "@radix-ui/react-popover": "1.2.0",
        "@rentnerkev/calendar": "2.6.0",
        "@rentnerkev/inputs": "2.7.0",
        "@rentnerkev/picker": "2.2.0",
        "@rentnerkev/select": "5.1.0",
        "@rentnerkev/toasts": "3.4.0",
        "@rentnerkev/tooltips": "2.1.0",
        "@simplewebauthn/browser": "14.0.0",
        "@simplewebauthn/server": "14.0.3",
        "@tanstack/charts": "1.0.0",
        "@tanstack/react-form": "1.33.5",
        "@tanstack/react-hotkeys": "0.13.0",
        "@tanstack/react-query": "5.104.1",
        "@tanstack/react-router": "1.170.41",
        "@tanstack/react-start": "1.168.60",
        "@tanstack/react-table": "9.2.6",
        "codemirror": "6.0.2",
        "country-flag-icons": "1.6.20",
        "drizzle-orm": "0.45.4",
        "i18next": "26.4.2",
        "i18next-resources-to-backend": "1.2.3",
        "lucide-react": "1.53.0",
        "maxmind": "5.0.7",
        "motion": "14.0.0",
        "nodemailer": "10.0.16",
        "otpauth": "9.5.2",
        "oxfmt": "0.72.0",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "react-easy-crop": "6.2.4",
        "react-qr-code": "2.2.0",
        "yauzl": "3.4.0",
        "zod": "4.6.5"
    },
    "devDependencies": {
        "@happy-dom/global-registrator": "20.14.5",
        "@tailwindcss/vite": "4.3.3",
        "@types/bun": "1.4.2",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@types/yauzl": "3.4.0",
        "@vitejs/plugin-react": "6.1.2",
        "drizzle-kit": "0.31.11",
        "fast-check": "4.10.2",
        "happy-dom": "20.14.5",
        "oxlint": "1.87.0",
        "oxlint-tsgolint": "7.0.2003",
        "tailwindcss": "4.3.3",
        "typescript": "7.0.2",
        "vite": "8.3.4"
    },
    "overrides": {
        "@esbuild-kit/core-utils": {
            "esbuild": "0.25.12"
        }
    },
    "packageManager": "bun@1.4.2"
}
