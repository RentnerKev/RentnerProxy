{
    "name": "rentnerproxy",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "bun --no-orphans scripts/dev.ts",
        "dev:web": "bun --bun vite --config web/vite.config.ts",
        "dev:controller": "cargo run --manifest-path controller/Cargo.toml",
        "proxy:test-upstream": "bun scripts/proxy-test-upstream.ts",
        "proxy:smoke": "bun --no-orphans scripts/proxy-smoke.ts",
        "certificates:smoke": "bun --no-orphans scripts/certificate-smoke.ts",
        "upstream-tls:smoke": "bun --no-orphans scripts/upstream-tls-smoke.ts",
        "backup:production": "bun scripts/production-backup.ts",
        "restore:production": "bun scripts/production-restore.ts",
        "production:smoke": "bun --no-orphans scripts/appliance-compose-smoke.ts",
        "build": "bun --no-orphans scripts/build.ts",
        "build:web": "bun --bun vite build --config web/vite.config.ts && tsc --noEmit -p web/tsconfig.json",
        "build:controller": "cargo build --release --manifest-path controller/Cargo.toml",
        "typecheck": "tsc --noEmit -p web/tsconfig.json && tsc --noEmit -p scripts/tsconfig.json",
        "lint": "oxlint .",
        "format": "oxfmt . && cargo fmt --manifest-path controller/Cargo.toml",
        "format:check": "oxfmt --check . && cargo fmt --manifest-path controller/Cargo.toml -- --check",
        "test": "bun run test:ts && bun run rust:test",
        "test:ts": "bun test --max-concurrency=1 --isolate web/src",
        "test:fuzz": "bun test web/src/tests/Fuzz",
        "db:generate": "drizzle-kit generate --config=web/drizzle.config.ts",
        "db:migrate": "bun web/src/db/migrate.ts",
        "db:check": "drizzle-kit check --config=web/drizzle.config.ts",
        "check": "bun --no-orphans scripts/check.ts",
        "rust:check": "cargo check --manifest-path controller/Cargo.toml --all-targets",
        "rust:test": "cargo test --manifest-path controller/Cargo.toml",
        "rust:lint": "cargo clippy --manifest-path controller/Cargo.toml --all-targets --all-features -- -D warnings",
        "rust:format": "cargo fmt --manifest-path controller/Cargo.toml",
        "rust:format:check": "cargo fmt --manifest-path controller/Cargo.toml -- --check"
    },
    "dependencies": {
        "@fontsource/lilita-one": "5.3.0",
        "@simplewebauthn/browser": "13.3.0",
        "@simplewebauthn/server": "13.3.3",
        "@tanstack/react-form": "1.33.5",
        "@tanstack/react-query": "5.102.8",
        "@tanstack/react-router": "1.170.32",
        "@tanstack/react-start": "1.168.49",
        "@tanstack/react-table": "9.2.3",
        "drizzle-orm": "0.45.2",
        "i18next": "^26.4.0",
        "i18next-resources-to-backend": "^1.2.3",
        "lucide-react": "1.34.0",
        "nodemailer": "9.0.6",
        "otpauth": "9.5.1",
        "qrcode.react": "4.2.0",
        "radix-ui": "1.6.7",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "react-easy-crop": "6.2.3",
        "zod": "4.4.3"
    },
    "devDependencies": {
        "@happy-dom/global-registrator": "20.11.15",
        "@tailwindcss/vite": "4.3.3",
        "@types/bun": "1.4.0",
        "@types/node": "26.4.0",
        "@types/nodemailer": "8.0.1",
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.5",
        "@vitejs/plugin-react": "6.1.0",
        "drizzle-kit": "0.31.10",
        "fast-check": "4.9.0",
        "oxfmt": "0.65.0",
        "oxlint": "1.80.0",
        "tailwindcss": "4.3.3",
        "typescript": "7.0.2",
        "vite": "8.2.2"
    },
    "overrides": {
        "@esbuild-kit/core-utils": {
            "esbuild": "0.25.12"
        }
    },
    "packageManager": "bun@1.4.0"
}
