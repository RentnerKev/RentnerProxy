{
    "name": "rentnerproxy",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "bun --no-orphans scripts/dev.ts",
        "dev:web": "bun --bun vite --configLoader native --config vite.config.ts",
        "dev:core": "bun --no-orphans scripts/dev-core.ts",
        "proxy:test-upstream": "bun scripts/smoke/proxy/upstream.ts",
        "proxy:smoke": "bun --no-orphans .github/scripts/ci/proxy-smoke.ts",
        "certificates:smoke": "bun --no-orphans scripts/smoke/certificates/run.ts",
        "upstream-tls:smoke": "bun --no-orphans scripts/smoke/proxy/upstream-tls.ts",
        "backup:production": "bun scripts/production-backup.ts",
        "restore:production": "bun scripts/production-restore.ts",
        "runtime:reliability": "bun --no-env-file --no-orphans scripts/runtime-reliability/run.ts",
        "runtime:scale": "bun --no-env-file --no-orphans scripts/runtime-scale/run.ts",
        "production:smoke": "bun --no-orphans .github/scripts/ci/appliance-compose-smoke.ts",
        "build": "bun --no-env-file --no-orphans scripts/build.ts",
        "build:web": "bun --no-env-file --bun vite build --configLoader native --config vite.config.ts && bun --no-env-file build web/src/server/WebSockets/realtimeWebSocket.ts --target=bun --outfile=web/dist/server/realtimeWebSocket.js && bun --no-env-file --check --tsconfig-override tsconfig.json",
        "build:core": "cargo build --release --manifest-path core/Cargo.toml",
        "typecheck": "bun --no-env-file --check --tsconfig-override tsconfig.json && bun --no-env-file run typecheck:scripts",
        "typecheck:scripts": "bun --no-env-file --check --tsconfig-override tsconfig.scripts.json",
        "dependencies:check": "bun --no-env-file node_modules/knip/bin/knip.js --dependencies",
        "dependencies:inspect": "bun --no-env-file node_modules/knip/bin/knip.js",
        "lint": "oxlint . && bun --no-env-file run lint:types",
        "lint:types": "oxlint --config .oxlintrc.type-aware.json .",
        "format": "bun --no-env-file fmt . && cargo fmt --manifest-path core/Cargo.toml",
        "format:check": "bun --no-env-file fmt --check . && cargo fmt --manifest-path core/Cargo.toml -- --check",
        "test": "bun --no-env-file run test:ts && bun --no-env-file run rust:test",
        "test:ts": "bun --no-env-file scripts/test-web.ts",
        "test:db": "bun --no-env-file scripts/test-web.ts --database",
        "test:fuzz": "bun --no-env-file scripts/test-web.ts --fuzz",
        "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
        "db:migrate": "bun web/src/db/migrate.ts",
        "db:check": "drizzle-kit check --config=drizzle.config.ts",
        "check": "bun --no-env-file --no-orphans scripts/check.ts",
        "check:full": "bun --no-env-file --no-orphans scripts/check.ts --full",
        "rust:check": "cargo check --manifest-path core/Cargo.toml --all-targets",
        "rust:test": "cargo test --manifest-path core/Cargo.toml",
        "rust:lint": "cargo clippy --manifest-path core/Cargo.toml --all-targets --all-features -- -D warnings",
        "rust:format": "cargo fmt --manifest-path core/Cargo.toml",
        "rust:format:check": "cargo fmt --manifest-path core/Cargo.toml -- --check"
    },
    "dependencies": {
        "@codemirror/autocomplete": "6.20.4",
        "@codemirror/commands": "6.11.1",
        "@codemirror/lang-html": "6.4.12",
        "@codemirror/language": "6.13.1",
        "@codemirror/search": "6.7.2",
        "@codemirror/state": "6.7.6",
        "@codemirror/view": "6.43.15",
        "@fontsource/lilita-one": "5.3.0",
        "@lezer/highlight": "1.2.5",
        "@radix-ui/react-dialog": "1.3.1",
        "@radix-ui/react-dropdown-menu": "2.2.1",
        "@radix-ui/react-focus-scope": "1.3.1",
        "@radix-ui/react-popover": "1.3.1",
        "@rentnerkev/calendar": "2.8.0",
        "@rentnerkev/inputs": "2.8.0",
        "@rentnerkev/picker": "2.3.1",
        "@rentnerkev/select": "6.0.0",
        "@rentnerkev/toasts": "3.7.0",
        "@rentnerkev/tooltips": "2.3.0",
        "@simplewebauthn/browser": "14.0.0",
        "@simplewebauthn/server": "14.0.3",
        "@tanstack/charts": "1.1.0",
        "@tanstack/react-form": "1.33.5",
        "@tanstack/react-hotkeys": "0.17.0",
        "@tanstack/react-query": "5.105.0",
        "@tanstack/react-router": "1.170.46",
        "@tanstack/react-start": "1.169.4",
        "@tanstack/react-table": "9.3.1",
        "country-flag-icons": "1.6.20",
        "drizzle-orm": "0.45.4",
        "fast-png": "8.0.0",
        "i18next": "26.5.11",
        "i18next-resources-to-backend": "1.2.3",
        "lucide-react": "1.61.0",
        "maxmind": "5.0.7",
        "motion": "14.7.1",
        "nodemailer": "10.2.1",
        "otpauth": "9.5.2",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "react-easy-crop": "6.2.4",
        "react-qr-code": "2.2.0",
        "yauzl": "3.4.0",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@happy-dom/global-registrator": "21.0.4",
        "@tailwindcss/vite": "4.3.3",
        "@types/bun": "1.4.4",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@types/yauzl": "3.4.0",
        "@vitejs/plugin-react": "6.1.2",
        "drizzle-kit": "0.31.11",
        "fast-check": "4.10.2",
        "happy-dom": "21.0.4",
        "knip": "6.43.0",
        "oxlint": "1.90.0",
        "oxlint-tsgolint": "7.0.2005",
        "tailwindcss": "4.3.3",
        "vite": "8.3.5"
    },
    "overrides": {
        "@esbuild-kit/core-utils": {
            "esbuild": "0.28.2"
        }
    },
    "packageManager": "bun@1.4.4"
}
