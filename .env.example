# Local development only. Production uses .env.production.example and generates all non-SMTP
# secrets inside its Docker volume.

# Application
APP_URL=http://localhost:5173

# Controller
# TanStack Start uses this server-side address to reach the controller.
RENTNERPROXY_CONTROLLER_URL=http://127.0.0.1:8081

# The controller listens on loopback by default for local development.
RENTNERPROXY_CONTROLLER_LISTEN_ADDR=127.0.0.1:8081

# Server-only bearer token. Required for any non-loopback controller listen address.
# Certificate management always requires this token, including on loopback.
# Optional for proxy-only loopback development; if set, proxy endpoints require it too.
# Use the same random 32-256 character base64url/hex token in web and runtime.
# Never use a VITE_ prefix, put this in browser code, or print the value in logs.
RENTNERPROXY_CONTROLLER_TOKEN=

# Optional Linux proxy engine. Leave unset for normal development without OpenResty.
# For the Docker dev runtime, these values are already set inside its image.
# RENTNERPROXY_PROXY_ENGINE_BIN=/usr/local/openresty/nginx/sbin/nginx
# Release controller + engine requires an explicit persistent absolute directory.
# RENTNERPROXY_PROXY_STATE_DIR=/var/lib/rentnerproxy/proxy
# Certificate material and ACME account credentials stay within the proxy state directory.
# RENTNERPROXY_PROXY_HTTP_PORT=8080
# RENTNERPROXY_PROXY_HTTPS_PORT=8443
# Server-only CA bundle for verified HTTPS upstreams; set a readable absolute path
# for your runtime distribution. The bundled Debian image supplies this default:
# RENTNERPROXY_SYSTEM_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
# HTTPS redirect port visible to clients (443 outside the local Docker stack).
# RENTNERPROXY_PROXY_PUBLIC_HTTPS_PORT=443
# Real ACME HTTP-01 requires public DNS and inbound port 80; .test uses manual test certificates.
# The explicit certificates:smoke test injects its own private Pebble directory and CA trust.
# Do not configure an ACME test override in a normal installation.

# Database
# Server-only PostgreSQL connection used by the TanStack Start application.
DATABASE_URL=postgresql://rentnerproxy:rentnerproxy@127.0.0.1:5432/rentnerproxy

# Redis
# Server-only ephemeral storage used for authentication challenges and rate limiting.
REDIS_URL=redis://127.0.0.1:6379

# Authentication encryption
# Server-only AES-256-GCM key, encoded as base64 (exactly 32 decoded bytes).
# Generate a fresh value for every environment; never commit the real key.
# openssl rand -base64 32
APP_ENCRYPTION_KEY=

# WebAuthn / passkeys
# Server-only relying-party ID. For the local URL above, use the host without a port.
WEBAUTHN_RP_ID=localhost

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Logging
RUST_LOG=info
