# Copy this file to .env next to the production Compose file.
# These are the only settings a normal installation needs outside the app.
RENTNERPROXY_PUBLIC_ORIGIN=https://management.example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=rentnerproxy@example.com
SMTP_PASSWORD=change-me
SMTP_FROM=RentnerProxy <rentnerproxy@example.com>

# Optional: when a known proxy terminates public TLS and forwards HTTP to this appliance.
# Trust only that proxy's direct socket peer addresses, never arbitrary private networks.
# Leave empty for direct deployments. This does not change management-web header trust.
# RENTNERPROXY_PROXY_TRUSTED_PROXY_CIDRS=192.0.2.10/32,2001:db8::10/128
