# Copy this file to .env next to the production Compose file.
# These are the only settings a normal installation needs outside the app.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=rentnerproxy@example.com
SMTP_PASSWORD=change-me
SMTP_FROM=RentnerProxy <rentnerproxy@example.com>
